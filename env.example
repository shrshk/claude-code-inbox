# Claude Code Inbox settings. Copy to ~/.cc-inbox/env; `ccinbox ensure-serve` and `ccinbox install-launchd`
# read it, and `set -a; . ~/.cc-inbox/env; set +a` loads it into a shell. Every value is optional.

# --- server -------------------------------------------------------------------
# Shared secret required on every API call once the server leaves loopback. Make one with: openssl rand -hex 6
export CCINBOX_TOKEN=
# 127.0.0.1 = this Mac only. 0.0.0.0 = reachable on your Wi-Fi (requires CCINBOX_TOKEN). Or a Tailscale address.
export CCINBOX_HOST=127.0.0.1
export CCINBOX_PORT=8787

# --- extraction ---------------------------------------------------------------
# export CCINBOX_MODEL=sonnet                 # model for claude -p
# export CCINBOX_MAX_BUDGET_USD=0.50          # per-call cap
# export CCINBOX_CLAUDE_BIN=/absolute/path/to/claude   # recommended under launchd
# export CCINBOX_MAX_CHARS=80000              # transcript budget sent to the model
# export CCINBOX_HEAD_RATIO=0.2               # share of the budget kept from the start of the session
# export CCINBOX_MIN_USER_TURNS=2             # shorter sessions are skipped without a model call
# export CCINBOX_MAX_ITEMS=5                  # per session

# --- timing -------------------------------------------------------------------
# export CCINBOX_DEBOUNCE_SEC=900             # Stop hook: one extraction per session per 15 min
# export CCINBOX_REFRESH_DEBOUNCE_SEC=300     # refresh button: skip sessions extracted in the last 5 min
# export CCINBOX_SWEEP_IDLE_MIN=20            # launchd sweep: only transcripts idle this long
# export CCINBOX_SWEEP_DAYS=1                 # launchd sweep window
# export CCINBOX_SNOOZE_HOUR=9                # local hour snoozed items return

# --- notifications ------------------------------------------------------------
# export CCINBOX_NTFY_TOPIC=                  # unguessable topic name on ntfy.sh
# export CCINBOX_NTFY_URL=https://ntfy.sh

# --- paths --------------------------------------------------------------------
# export CCINBOX_HOME=~/.cc-inbox             # DB, logs, lock, work dir
